# ── Chain ────────────────────────────────────────────────────────────────────
# "local" (default, anvil on 31337) or "target" to use the values below.
NEXT_PUBLIC_CHAIN=local

# Fill these in to point the app at a real network (e.g. Robinhood Chain, once it
# publishes an RPC and a chain id). NEXT_PUBLIC_CHAIN=target is ignored until both
# NEXT_PUBLIC_CHAIN_ID and NEXT_PUBLIC_RPC_URL are set.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
NEXT_PUBLIC_CHAIN_TESTNET=true

# Absolute origin of the deployed site, so shared links and OG tags resolve.
NEXT_PUBLIC_SITE_URL=

# Which deployment manifest scripts/sync-abi.mjs bakes into the build:
# reads contracts/deployments/<DEPLOYMENT>.json  (local | production | <your name>)
DEPLOYMENT=local

# ── Deploy / keeper (server side, never NEXT_PUBLIC_) ────────────────────────
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
